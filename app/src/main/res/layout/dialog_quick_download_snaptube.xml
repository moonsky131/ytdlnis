<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Drag Handle Indicator -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/rounded_corner"
            android:backgroundTint="?attr/colorOutlineVariant" />

        <!-- Header Card: Thumbnail, Title, Subtitle, Close Button -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quick_thumb_card"
                android:layout_width="96dp"
                android:layout_height="64dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/quick_media_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    tools:srcCompat="@tools:sample/backgrounds/scenic" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/quick_media_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/quick_close_button"
                app:layout_constraintStart_toEndOf="@+id/quick_thumb_card"
                app:layout_constraintTop_toTopOf="@+id/quick_thumb_card"
                tools:text="Video Title That Might Be Long Enough To Span Two Lines" />

            <TextView
                android:id="@+id/quick_media_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOutline"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@+id/quick_close_button"
                app:layout_constraintStart_toEndOf="@+id/quick_thumb_card"
                app:layout_constraintTop_toBottomOf="@+id/quick_media_title"
                tools:text="Channel Name • 3:45" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_close_button"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/cancel"
                app:icon="@drawable/baseline_close_24"
                app:iconTint="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/quick_thumb_card" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Sleek Non-Shifting Progress Indicator -->
        <FrameLayout
            android:id="@+id/quick_loading_container"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:visibility="invisible"
            tools:visibility="visible">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:indeterminate="true"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="@android:color/transparent" />
        </FrameLayout>

        <!-- Main Content: Music & Video Sections -->
        <LinearLayout
            android:id="@+id/quick_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp">

            <!-- Music Section Header -->
            <LinearLayout
                android:id="@+id/music_section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/music"
                    android:src="@drawable/ic_music"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/music"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Music Formats Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/quick_audio_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Video Section Header -->
            <LinearLayout
                android:id="@+id/video_section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/video_title"
                    android:src="@drawable/ic_video"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/video_title"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Video Formats Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/quick_video_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>

        <!-- Advanced Options Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/quick_advanced_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:text="@string/advanced_options"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
